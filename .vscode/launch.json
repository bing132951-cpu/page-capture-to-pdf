{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run JPG Links Web App",
      "type": "python",
      "request": "launch",
      "module": "scribd_exporter.webapp",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run Tests",
      "type": "python",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}

