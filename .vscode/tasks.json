{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python3 -m unittest discover -s tests -v",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test"
    },
    {
      "label": "Collect pages",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scribd_exporter.cli",
        "collect",
        "--target-url",
        "${input:documentUrl}",
        "--output",
        "output/pages.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Export PDF from collected JSON",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scribd_exporter.cli",
        "export",
        "--pages-json",
        "output/pages.json",
        "--output",
        "output/document.pdf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Export PDF from URL list",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scribd_exporter.cli",
        "export",
        "--url-list",
        "xx.txt",
        "--output",
        "output/document.pdf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Start JPG Links Web App",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scribd_exporter.webapp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ],
  "inputs": [
    {
      "id": "documentUrl",
      "type": "promptString",
      "description": "Document page URL"
    }
  ]
}
